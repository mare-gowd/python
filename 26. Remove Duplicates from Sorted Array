class Solution(object):
    def removeDuplicates(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        # x=len(nums)
        # nums[:]=list(set(nums))
        # nums.sort()
        # x=len(nums)
        # return x

        x=1
        while x!=len(nums):
            if nums[x]==nums[x-1]:
                nums.pop(x)
            else:
                x+=1
        return len(nums)        
